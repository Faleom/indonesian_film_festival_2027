# Copy to .env for local development; in production set these in Vercel
# (Project -> Settings -> Environment Variables). See docs/SETUP-BACKEND.md.
# Everything works without them; each feature switches on when its keys are set.

# Supabase -> Project settings -> Database -> Connection string (pooler, port 6543)
DATABASE_URL=

# Stripe -> Developers -> API keys (sk_test_... for testing, sk_live_... for real sales)
STRIPE_SECRET_KEY=
# Stripe -> Developers -> Webhooks -> your endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET=

# Resend -> API keys. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Indonesian Film Festival <tickets@your-domain.com>"
EMAIL_REPLY_TO=

# Committee addresses notified about every order, SFC entry and message (comma separated)
ADMIN_NOTIFY_EMAILS=

# Keyword that unlocks /admin (12+ characters, keep it secret)
ADMIN_KEY=

# Public URL of the site (used in emails and Stripe redirects)
SITE_URL=
