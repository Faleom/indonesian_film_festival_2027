---
import Form from './Form.astro';
import Field from './Field.astro';
import pages from '../../content/pages.json';
---

<Form name="contact" submitLabel="Send message">
  <div class="grid gap-5 sm:grid-cols-2">
    <Field formId="contact" name="name" label="Name" required autocomplete="name" />
    <Field formId="contact" name="email" label="Email" type="email" required autocomplete="email" />
  </div>
  <Field formId="contact" name="subject" label="Subject" type="select" required options={pages.faq.contactSubjects} />
  <Field formId="contact" name="message" label="Message" type="textarea" required />
</Form>
