---
/** Labelled input / textarea / select. */
interface Props {
  name: string;
  label: string;
  type?: 'text' | 'email' | 'tel' | 'textarea' | 'select';
  required?: boolean;
  autocomplete?: string;
  placeholder?: string;
  options?: string[];
  formId: string;
}

const { name, label, type = 'text', required = false, autocomplete, placeholder, options = [], formId } = Astro.props;
const id = `${formId}-${name}`;
---

<div class="field">
  <label for={id} class="field__label">
    {label}{required ? ' *' : ''}
  </label>
  {
    type === 'textarea' ? (
      <textarea id={id} name={name} class="field__input" required={required} placeholder={placeholder} />
    ) : type === 'select' ? (
      <select id={id} name={name} class="field__input" required={required}>
        <option value="">Select…</option>
        {options.map((o) => (
          <option value={o}>{o}</option>
        ))}
      </select>
    ) : (
      <input
        id={id}
        name={name}
        type={type}
        class="field__input"
        required={required}
        autocomplete={autocomplete}
        placeholder={placeholder}
      />
    )
  }
</div>
