---
/**
 * Form shell. Posts to a real endpoint (src/pages/api/*). Works without JS
 * (the server redirects to /thanks); with JS, scripts/forms.ts sends it with
 * fetch and shows the reply in the toast. `website` is a honeypot: hidden from
 * people, filled in by bots, and those posts are ignored.
 */
interface Props {
  name: string;
  /** Endpoint, e.g. /api/contact */
  action: string;
  submitLabel: string;
  class?: string;
  /** Clear the fields after a successful send (default true). */
  reset?: boolean;
}

const { name, action, submitLabel, class: className, reset = true } = Astro.props;
---

<form class:list={['flex flex-col gap-5', className]} id={name} name={name} method="post" action={action} data-api data-reset={reset ? '' : undefined} data-astro-reload>
  <div class="hp-field" aria-hidden="true">
    <label for={`${name}-website`}>Leave this empty</label>
    <input id={`${name}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <slot />
  <div class="flex flex-wrap items-center gap-4">
    <button type="submit" class="btn btn--primary cursor-pointer">{submitLabel}</button>
    <slot name="after" />
  </div>
</form>
