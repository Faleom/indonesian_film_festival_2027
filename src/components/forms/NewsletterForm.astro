---
import Form from './Form.astro';
import Field from './Field.astro';
import pages from '../../content/pages.json';

interface Props {
  /** Footer version: smaller title. */
  compact?: boolean;
}

const { compact = false } = Astro.props;
const { newsletterTitle, newsletterText } = pages.home;
const formId = compact ? 'newsletter-footer' : 'newsletter';
---

<div class="flex flex-col gap-4">
  {
    compact ? (
      <p class="kicker m-0">{newsletterTitle}</p>
    ) : (
      <h2 class="heading-condensed">{newsletterTitle}</h2>
    )
  }
  <p class="m-0 max-w-[48ch] text-[0.9375rem]">{newsletterText}</p>
  <Form name={formId} submitLabel="Subscribe">
    <Field formId={formId} name="email" label="Email" type="email" required autocomplete="email" />
  </Form>
</div>
