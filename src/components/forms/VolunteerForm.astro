---
import Form from './Form.astro';
import Field from './Field.astro';
import pages from '../../content/pages.json';

const roles = pages.volunteer.roles.map((r) => r.title);
---

<Form name="volunteer" submitLabel="Register interest">
  <div class="grid gap-5 sm:grid-cols-2">
    <Field formId="volunteer" name="name" label="Full name" required autocomplete="name" />
    <Field formId="volunteer" name="email" label="Email" type="email" required autocomplete="email" />
    <Field formId="volunteer" name="phone" label="Phone" type="tel" autocomplete="tel" />
    <Field formId="volunteer" name="study" label="University or occupation" />
  </div>
  <fieldset class="m-0 flex flex-col gap-3 border-0 p-0">
    <legend class="field__label mb-3">Roles you're interested in</legend>
    <div class="grid gap-3 sm:grid-cols-2">
      {
        roles.map((role) => (
          <label class="check">
            <input type="checkbox" name="roles" value={role} />
            <span>{role}</span>
          </label>
        ))
      }
    </div>
  </fieldset>
  <Field formId="volunteer" name="message" label="Anything else? (availability, experience)" type="textarea" />
  <label class="check">
    <input type="checkbox" name="consent" required />
    <span>I'm happy for the IFF committee to contact me about volunteering. *</span>
  </label>
</Form>
