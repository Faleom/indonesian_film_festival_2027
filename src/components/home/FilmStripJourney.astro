---
/**
 * The festival journey. Static cards by default; with motion on and WebGL, a
 * 3D film strip (scripts/three/filmStrip.ts) of each event's title card and
 * frames (events.json `strip`), moved sideways: swipe/drag, the arrows, the
 * event tabs or the keyboard. It re-inks in the colours of the event at the centre.
 */
import SectionHead from '../ui/SectionHead.astro';
import JourneyStrip from '../sections/JourneyStrip.astro';
import pages from '../../content/pages.json';
import { eventHref, getEvents, getFilms, type EventId } from '../../lib/content';
import { media, textureFor } from '../../lib/media';

const page = pages.home;
const events = await getEvents();

const frames: { event: number; kind: 'title' | 'media'; label?: string; type?: string; src?: string | null }[] = [];
for (const [i, e] of events.entries()) {
  frames.push({ event: i, kind: 'title' });
  // Frames come from events.json `strip`; without one, the b-roll plus two film posters.
  const keys = e.data.strip ?? [`broll-${e.id}`, ...(await getFilms(e.id as EventId)).slice(0, 2).map((f) => f.data.poster)];
  for (const key of keys) {
    if (!media[key]) {
      console.warn(`[film-strip] Unknown media key "${key}" in events.json strip.`);
      continue;
    }
    const tex = textureFor(key);
    frames.push({ event: i, kind: 'media', type: tex.type, src: tex.src, label: `[${tex.type === 'video' ? 'VIDEO' : 'IMG'}: ${key}]` });
  }
}
const strip = {
  events: events.map((e) => ({ id: e.id, theme: e.data.theme, name: e.data.name, date: e.data.dateLabel })),
  frames,
};
---

<section
  id="festival-journey"
  class="strip3d"
  data-halftone-3d="filmstrip"
  data-preload="idle"
  data-variant="solid"
  data-live-layout
  data-strip={JSON.stringify(strip)}
  style={`--frames: ${frames.length}`}
  aria-labelledby="journey"
>
  <!-- Static layout: no JS, phones, reduced motion -->
  <div class="strip3d__static container-page py-12 md:py-20">
    <SectionHead title={page.journeyTitle} kicker={page.journeyKicker} id="journey" />
    <JourneyStrip events={events} />
  </div>

  <!-- Live 3D stage -->
  <div
    class="strip3d__stage"
    data-strip-stage
    tabindex="0"
    role="region"
    aria-roledescription="carousel"
    aria-label={`${page.journeyTitle}. ${page.journeyHint}, or use the left and right arrow keys.`}
  >
    <div class="strip3d__hud container-page">
      <p class="kicker" data-tone="accent">{page.journeyKicker} · {page.journeyTitle}</p>
      <ol class="strip3d__segments">
        {
          events.map((e) => (
            <li data-strip-seg data-theme={e.data.theme}>
              <button type="button" class="strip3d__seg-btn">{e.data.shortName}<span class="sr-only">: {e.data.name}</span></button>
            </li>
          ))
        }
      </ol>
    </div>

    <button type="button" class="strip3d__arrow strip3d__arrow--prev" data-strip-prev aria-label={page.journeyPrev}>
      <span aria-hidden="true">←</span>
    </button>
    <button type="button" class="strip3d__arrow strip3d__arrow--next" data-strip-next aria-label={page.journeyNext}>
      <span aria-hidden="true">→</span>
    </button>
    <p class="strip3d__hint" aria-hidden="true">
      <span class="strip3d__hint-hand">⟷</span>
      {page.journeyHint}
    </p>

    {
      events.map((e, i) => (
        <article class="strip3d__panel container-page" data-strip-panel data-theme={e.data.theme}>
          <p class="kicker" data-tone="accent">
            Event {String(i + 1).padStart(2, '0')} / {String(events.length).padStart(2, '0')}
          </p>
          <h2 class="strip3d__name">{e.data.name}</h2>
          <p class="strip3d__meta">{e.data.dateLabel} · {e.data.venue}</p>
          <p class="m-0 max-w-[40ch]">{e.data.summary}</p>
          <a href={eventHref(e)} class="btn btn--primary mt-2 self-start">Explore {e.data.shortName} →</a>
        </article>
      ))
    }

    <p class="strip3d__timecode" aria-hidden="true">
      <span data-strip-timecode>00:00:00:00</span>
    </p>
  </div>
</section>

<script>
  import '../../scripts/three/loader';
</script>
