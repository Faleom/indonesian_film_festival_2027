---
/**
 * @font-face for the brand fonts in /public/fonts (see src/content/fonts.json
 * for accepted file names). Missing files get a local()-only rule (used if
 * the visitor has the font installed, never 404s) and the CSS stacks fall
 * back to the self-hosted free fonts (@fontsource, imported in BaseLayout).
 */
import fontData from '../../content/fonts.json';
import { findFontFile, hasDisplayFont } from '../../lib/fonts';

const faces = fontData.fonts
  .filter((f) => !f.google)
  .flatMap((f) => {
    const locals = ((f as { localNames?: string[] }).localNames ?? [f.family]).map((n) => `local('${n}')`).join(', ');
    return f.files.map((file) => {
      const found = findFontFile(file.names);
      const src = found ? `url('${found.url}') format('${found.format}'), ${locals}` : locals;
      return `@font-face{font-family:'${f.family}';src:${src};font-weight:${file.weight};font-style:${file.style};font-display:swap;}`;
    });
  });

// The real Rushford is already distressed, so turn off the ink-wear stand-in.
if (hasDisplayFont()) faces.push(':root{--display-wear:none}');

const preloads = fontData.fonts
  .filter((f) => f.cssVar === '--ff-display' || f.cssVar === '--ff-body')
  .map((f) => findFontFile(f.files[0]?.names ?? []))
  .filter((f) => f && f.format === 'woff2');
---

{preloads.map((f) => <link rel="preload" href={f!.url} as="font" type="font/woff2" crossorigin />)}
<style is:inline set:html={faces.join('\n')}></style>
