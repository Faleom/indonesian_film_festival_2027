---
/**
 * Loading screen for the first page of a visit: a film countdown leader
 * (3, 2, 1) printed in halftone dots of the page theme, on the paper.
 *
 * Shown only while <html data-loading="on"> (set before paint by
 * MotionHead.astro: motion on, first page of the session). Meanwhile the 3D
 * scenes build behind it (scripts/three/loader.ts mounts them all right away),
 * so their setup never lands mid-scroll. It leaves when they're ready and the
 * fonts have loaded: at least MIN_MS so the countdown reads, at most MAX_MS.
 * A tap, click or key press skips it. It leaves through growing dot holes.
 */
import site from '../../content/site.json';
---

<div class="loader" aria-hidden="true">
  <div class="loader__leader">
    <div class="loader__sweep"></div>
    <svg class="loader__marks" viewBox="0 0 200 200" focusable="false">
      <circle cx="100" cy="100" r="92"></circle>
      <circle cx="100" cy="100" r="74"></circle>
      <path d="M100 0v200M0 100h200"></path>
    </svg>
    <span class="loader__count" data-loader-count>3</span>
  </div>
  <p class="loader__label">
    <span>{site.loadingLabel}</span>
    <span>{site.edition} {site.name}</span>
  </p>
</div>

<script>
  const MIN_MS = 1400;
  const MAX_MS = 4000;
  const OUT_MS = 700;

  const d = document.documentElement;
  if (d.dataset.loading === 'on') {
    const start = performance.now();
    const count = document.querySelector<HTMLElement>('[data-loader-count]');
    const sweep = document.querySelector<HTMLElement>('.loader__sweep');
    let n = 3;
    // One number per turn of the sweep, like a real leader: 3, 2, 1, 3...
    sweep?.addEventListener('animationiteration', () => {
      n = n === 1 ? 3 : n - 1;
      if (count) count.textContent = String(n);
    });

    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      try {
        sessionStorage.setItem('iff-loaded', '1');
      } catch {}
      d.dataset.loading = 'out';
      setTimeout(() => delete d.dataset.loading, OUT_MS);
    };

    const after = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));
    const loaded = document.readyState === 'complete' ? Promise.resolve() : new Promise<void>((r) => addEventListener('load', () => r(), { once: true }));
    // scripts/three/loader.ts sets the flag / fires the event once every 3D block has built (or failed).
    const scenes = (window as any).__ht3dSettled ? Promise.resolve() : new Promise<void>((r) => document.addEventListener('ht3d:settled', () => r(), { once: true }));
    const ready = Promise.all([loaded, document.fonts.ready, scenes]).then(() => after(Math.max(0, MIN_MS - (performance.now() - start))));
    Promise.race([ready, after(MAX_MS)]).then(finish);

    // Never hold anyone up: any tap, click or key skips it.
    const skip = () => finish();
    addEventListener('pointerdown', skip, { once: true });
    addEventListener('keydown', skip, { once: true });
  }
</script>
