---
/**
 * Runs before first paint and sets <html data-motion="on|off">.
 * Motion is off when the visitor prefers reduced motion, or turned it off
 * with the footer toggle (stored in localStorage as iff-motion=off|on).
 * Content is never hidden here: reveals hide only off-screen elements, once
 * the motion engine has loaded (see scripts/motion/reveals.ts).
 */
---

<script is:inline>
  (function () {
    var d = document.documentElement;
    var stored = null;
    try {
      stored = localStorage.getItem('iff-motion');
    } catch (e) {}
    var off = stored === 'off' || (stored !== 'on' && matchMedia('(prefers-reduced-motion: reduce)').matches);
    d.dataset.motion = off ? 'off' : 'on';
  })();
</script>
