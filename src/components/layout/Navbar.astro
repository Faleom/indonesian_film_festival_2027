---
import fs from 'node:fs';
import nodePath from 'node:path';
import site from '../../content/site.json';
import { eventHref, getEvents } from '../../lib/content';

// Festival logo, generated from src/assets/brand/logo.* by scripts/favicons.mjs (black on transparent).
const hasLogo = fs.existsSync(nodePath.join(process.cwd(), 'public/brand/logo.png'));

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));

// The item with `events: true` in site.json nav becomes the Events menu, built from events.json.
const events = (await getEvents()).map((e) => ({ ...e.data, href: eventHref(e) }));
const onEventPage = events.some((e) => isCurrent(e.href));
---

<header class="site-header" data-site-header>
  <div class="site-header__bar">
    <div class="container-page flex items-center justify-between gap-4 py-1.5">
      <span>{site.edition} edition · {site.city}</span>
      <span class="flex items-center gap-4">
        <span class="hidden sm:inline">{site.dates}</span>
        <!-- Top of every page, so slow devices can switch motion off right away.
             Shown by scripts/motion/index.ts; the choice is remembered per browser. -->
        <button id="motion-toggle" type="button" class="motion-toggle" hidden aria-pressed="true">
          Motion: <span data-motion-state>On</span>
        </button>
      </span>
    </div>
  </div>

  <div class="site-header__main container-page flex items-center justify-between gap-6">
    <a href="/" class="site-brand flex items-baseline gap-3 text-ink no-underline">
      {hasLogo && <img src="/brand/logo.png" alt="" width="34" height="48" class="site-logo" />}
      <span class="site-brand__iff font-display leading-none uppercase" style="color: var(--c-display-top)">{site.shortName}</span>
      <span class="site-brand__num font-script leading-none" style="color: var(--c-display-bottom)">{site.editionNumber}</span>
      <span class="site-brand__full hidden font-typewriter text-xs leading-tight uppercase tracking-widest md:block">
        {site.edition}<br />{site.name}
      </span>
      <span class="sr-only">, home</span>
    </a>

    <nav aria-label="Main" class="nav-main hidden xl:block">
      <ul class="m-0 flex list-none items-center gap-5 p-0 2xl:gap-7">
        {
          site.nav.map((item) =>
            'events' in item ? (
              <li class="relative">
                <details class="nav-events" data-nav-events>
                  <summary class="nav-link" aria-current={onEventPage ? 'true' : undefined}>
                    {item.label}
                    <span class="nav-events__caret" aria-hidden="true">▾</span>
                  </summary>
                  <ul class="nav-events__panel m-0 list-none p-0">
                    {events.map((e) => (
                      <li data-theme={e.theme}>
                        <a href={e.href} class="nav-events__item" aria-current={isCurrent(e.href) ? 'page' : undefined}>
                          <span class="nav-dot" aria-hidden="true" />
                          <span class="nav-events__name">
                            {e.name}
                            {e.badge && <span class="nav-badge">{e.badge}</span>}
                          </span>
                          <span class="nav-events__date">{e.shortDate}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ) : (
              <li>
                <a href={item.href} class="nav-link" aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            )
          )
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a href="/cart" class="nav-cart" aria-label={site.cartLabel}>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M3 4h2.2l2.3 10.2a1 1 0 0 0 1 .8h8.7a1 1 0 0 0 1-.8L20 7.5H6.2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="9.5" cy="19" r="1.5" fill="currentColor"/><circle cx="16.5" cy="19" r="1.5" fill="currentColor"/></svg>
        <span class="nav-cart__count" data-cart-count hidden>0</span>
      </a>
      <a href={site.ticketUrl} class="btn btn--primary hidden sm:inline-flex">Tickets</a>
      <details class="nav-menu xl:hidden">
        <summary class="btn btn--ghost" aria-label="Menu">
          <span class="nav-menu__icon-open">Menu</span>
          <span class="nav-menu__icon-close">Close</span>
        </summary>
        <nav aria-label="Main" class="nav-menu__panel">
          <ul class="m-0 flex list-none flex-col p-0">
            {
              site.nav.map((item) =>
                'events' in item ? (
                  <li class="border-b border-ink/30 pb-2">
                    <p class="kicker mt-1 mb-1">{item.label}</p>
                    <ul class="m-0 list-none p-0">
                      {events.map((e) => (
                        <li data-theme={e.theme}>
                          <a href={e.href} class="nav-link flex items-baseline gap-2 py-2 text-lg" aria-current={isCurrent(e.href) ? 'page' : undefined}>
                            <span class="nav-dot" aria-hidden="true" />
                            <span>
                              {e.name}
                              {e.badge && <span class="nav-badge">{e.badge}</span>}
                            </span>
                            <span class="nav-events__date ml-auto">{e.shortDate}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </li>
                ) : (
                  <li class="border-b border-ink/30">
                    <a href={item.href} class="nav-link block py-3 text-lg" aria-current={isCurrent(item.href) ? 'page' : undefined}>
                      {item.label}
                    </a>
                  </li>
                )
              )
            }
          </ul>
          <a href={site.ticketUrl} class="btn btn--primary mt-5 w-full sm:hidden">Tickets</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Events menu: close on outside click, Escape or after picking a page. Opens without JS (<details>).
  const close = (except?: Element) =>
    document.querySelectorAll<HTMLDetailsElement>('[data-nav-events][open]').forEach((d) => d !== except && (d.open = false));
  document.addEventListener('click', (ev) => close((ev.target as Element).closest('[data-nav-events]') ?? undefined));
  document.addEventListener('keydown', (ev) => {
    if (ev.key !== 'Escape') return;
    const open = document.querySelector<HTMLDetailsElement>('[data-nav-events][open]');
    if (!open) return;
    open.open = false;
    open.querySelector('summary')?.focus();
  });
  document.addEventListener('astro:after-swap', () => close());

  /*
   * Auto-hiding header (JS only; without JS it simply sits at the top of the page).
   * - At the top: the full header.
   * - Scrolled past it: a compact bar that hides while scrolling down and comes
   *   back when scrolling up, when scrolling stops, or when the mouse nears the top.
   * - Stays put while a menu is open, the pointer is over it or it has focus.
   * Only transform/opacity change (no layout), and nothing is measured per frame:
   * the header height is read on load and on resize only.
   */
  const IDLE_MS = 350; // show again this long after scrolling stops
  const NEAR_TOP_PX = 72; // mouse this close to the top edge reveals the bar
  let header: HTMLElement | null = null;
  let full = 0;
  let lastY = 0;
  let idle = 0;
  let queued = false;
  let hovering = false;

  const set = (cls: string, on: boolean) => header && header.classList.contains(cls) !== on && header.classList.toggle(cls, on);
  const pinned = () =>
    !!header && (hovering || header.matches(':focus-within') || !!header.querySelector('details[open]'));
  const measure = () => {
    if (!header) return;
    const was = header.classList.contains('is-compact');
    header.classList.remove('is-compact');
    full = header.offsetHeight;
    document.documentElement.style.setProperty('--header-h', `${full}px`);
    header.classList.toggle('is-compact', was);
  };
  const update = () => {
    queued = false;
    if (!header) return;
    const y = Math.max(0, scrollY);
    const dy = y - lastY;
    lastY = y;
    set('is-compact', y > full * 0.6);
    if (y <= full) set('is-hidden', false);
    else if (dy > 4 && !pinned()) set('is-hidden', true);
    else if (dy < -4) set('is-hidden', false);
    clearTimeout(idle);
    idle = window.setTimeout(() => set('is-hidden', false), IDLE_MS);
  };
  const onScroll = () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(update);
  };
  const onPointer = (e: PointerEvent) => {
    if (e.pointerType === 'mouse' && e.clientY < NEAR_TOP_PX) set('is-hidden', false);
  };

  function setupHeader() {
    header = document.querySelector<HTMLElement>('[data-site-header]');
    if (!header) return;
    hovering = false;
    header.addEventListener('pointerenter', () => (hovering = true));
    header.addEventListener('pointerleave', () => (hovering = false));
    header.addEventListener('focusin', () => set('is-hidden', false));
    measure();
    lastY = scrollY;
    update();
  }
  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('pointermove', onPointer, { passive: true });
  addEventListener('resize', measure);
  document.addEventListener('astro:page-load', setupHeader);
</script>
