---
/** Faint newspaper columns behind the page. Purely decorative. */
import newsprint from '../../content/newsprint.json';

// Repeat the copy so the columns fill wide screens.
const blocks = Array.from({ length: 4 }, () => newsprint);
---

<div class="newsprint" aria-hidden="true">
  {
    blocks.map((block) => (
      <Fragment>
        <h2>{block.headline}</h2>
        {block.paragraphs.map((p) => (
          <p>{p}</p>
        ))}
      </Fragment>
    ))
  }
</div>
