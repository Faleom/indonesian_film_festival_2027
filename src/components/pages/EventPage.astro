---
/** Shared template for every event page (/sfc, /exhibition, /uts, /edu-screening, /main-screening). All copy comes from events.json. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventHero3D from './EventHero3D.astro';
import FilmCard from '../sections/FilmCard.astro';
import VideoPlayer from '../sections/VideoPlayer.astro';
import SectionHead from '../ui/SectionHead.astro';
import KeyDates from '../sections/KeyDates.astro';
import InkWipe from '../ui/InkWipe.astro';
import LineupSoon from '../sections/LineupSoon.astro';
import BodyText from '../typography/BodyText.astro';
import Kicker from '../typography/Kicker.astro';
import site from '../../content/site.json';
import pages from '../../content/pages.json';
import { eventHref, filmHref, getEvent, getEvents, getFilms, type EventId } from '../../lib/content';

interface Props {
  id: EventId;
  /** Skip the "Coming soon" lineup block (e.g. the exhibition shows its own content instead). */
  hideLineupSoon?: boolean;
}

const { hideLineupSoon = false } = Astro.props;
const event = await getEvent(Astro.props.id);
const e = event.data;
const [films, events] = await Promise.all([getFilms(event.id as EventId), getEvents()]);
// Lineup is shown only once announced (events.json `lineupAnnounced`) and there are films.
const showLineup = e.lineupAnnounced && films.length > 0;
const index = events.findIndex((x) => x.id === event.id);
const next = events[index + 1];
const prev = events[index - 1];
---

<BaseLayout title={`${e.name} · ${site.shortName} ${site.editionNumber}`} description={e.summary} theme={e.theme} reprint ogImage={e.hero}>
  <EventHero3D event={event} hasLineup={showLineup || !hideLineupSoon} />

  <section class="container-page py-12 md:py-20" aria-labelledby="about-event">
    <div class="event-intro">
      <div>
        <SectionHead title={`${pages.event.aboutTitle} ${e.shortName}`} id="about-event" />
        <BodyText size="lead" dropcap>
          {e.description.map((p) => <p>{p}</p>)}
        </BodyText>
        <slot name="intro" />
      </div>
      <aside data-reveal="print" class="event-card" aria-label="Event details">
        <div class="event-card__section">
          <Kicker tone="accent" class="mb-4">{pages.event.atAGlance}</Kicker>
          <dl>
            <div><dt>Date</dt><dd>{e.dateLabel}</dd></div>
            <div><dt>Time</dt><dd>{e.time}</dd></div>
            <div><dt>Venue</dt><dd>{e.venue}</dd></div>
            {showLineup && <div><dt>Films</dt><dd>{films.length}</dd></div>}
          </dl>
        </div>
        {
          e.keyDates && e.keyDates.length > 0 && (
            <div class="event-card__section">
              <Kicker tone="accent" class="mb-4">{pages.event.keyDatesTitle}</Kicker>
              <KeyDates dates={e.keyDates} nextLabel={pages.event.nextUpLabel} vertical />
            </div>
          )
        }
        <slot name="card" />
      </aside>
    </div>
  </section>

  <slot />

  {
    e.trailer && (
      <section class="container-page py-12 md:py-20" aria-labelledby="trailer">
        <SectionHead title="Trailer" kicker="Watch" id="trailer" />
        <VideoPlayer id={e.trailer} class="mx-auto max-w-5xl" />
      </section>
    )
  }

  <InkWipe />

  {/* Lineup: while events.json `lineupAnnounced` is false, a "Coming soon" block stands in.
      The film list below is kept as is and comes back when it's set to true. */}
  {!showLineup && !hideLineupSoon && <LineupSoon lineupTitle={e.lineupTitle} eventName={e.name} />}

  {
    showLineup && films.length === 1 && (
      <section id="lineup" class="container-page py-12 md:py-20" aria-labelledby="lineup-title">
        <SectionHead title={e.lineupTitle} kicker="1 film" id="lineup-title" />
        <div class="film-feature">
          <FilmCard film={films[0]} />
          <div class="flex flex-col gap-5">
            <p class="heading-condensed m-0 text-3xl" style="color: var(--c-display-top)">{films[0].data.title}</p>
            <BodyText size="lead"><p>{films[0].data.synopsis}</p></BodyText>
            <p class="m-0"><a href={filmHref(films[0])} class="btn btn--ghost">Film details</a></p>
          </div>
        </div>
      </section>
    )
  }

  {
    showLineup && films.length > 1 && (
      <section id="lineup" class="container-page py-12 md:py-20" aria-labelledby="lineup-title">
        <SectionHead title={e.lineupTitle} kicker={`${films.length} films`} id="lineup-title" />
        <ul data-reveal="fold" data-reveal-children data-reveal-stagger="0.1" class="clipping-grid m-0 grid list-none grid-cols-2 gap-x-4 gap-y-10 p-0 sm:gap-x-6 sm:gap-y-12 lg:grid-cols-3 xl:grid-cols-4">
          {films.map((film) => (
            <li>
              <FilmCard film={film} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <nav data-reveal="print" data-reveal-children data-reveal-stagger="0.15" class="container-page grid gap-4 py-12 md:grid-cols-2" aria-label="Festival journey">
    {
      prev ? (
        <a href={eventHref(prev)} data-theme={prev.data.theme} class="group flex flex-col gap-2 border border-ink p-6 text-ink no-underline hover:bg-primary hover:text-on-primary">
          <span class="font-typewriter text-xs tracking-widest uppercase">← Previously on the journey</span>
          <span class="font-display text-4xl leading-none uppercase md:text-5xl">{prev.data.name}</span>
        </a>
      ) : <span class="hidden md:block" />
    }
    {
      next && (
        <a href={eventHref(next)} data-theme={next.data.theme} class="group flex flex-col gap-2 border border-ink p-6 text-right text-ink no-underline hover:bg-primary hover:text-on-primary">
          <span class="font-typewriter text-xs tracking-widest uppercase">Next on the journey →</span>
          <span class="font-display text-4xl leading-none uppercase md:text-5xl">{next.data.name}</span>
        </a>
      )
    }
  </nav>
</BaseLayout>
