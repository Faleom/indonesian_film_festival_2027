---
/** SFC -> Under the Stars -> Edu -> Main, each card in its own theme. */
import { eventHref, type EventEntry } from '../../lib/content';

interface Props {
  events: EventEntry[];
}

const { events } = Astro.props;
---

<ol data-reveal="fade-up" data-reveal-children data-reveal-stagger="0.12" class="m-0 grid list-none gap-5 p-0 md:grid-cols-2 xl:grid-cols-4 xl:gap-0">
  {
    events.map((e, i) => (
      <li data-theme={e.data.theme} class="relative flex">
        <a
          href={eventHref(e)}
          class="group flex w-full flex-col gap-4 border border-ink bg-offwhite/50 p-6 text-ink no-underline transition-colors hover:bg-primary hover:text-on-primary md:p-8"
        >
          <span class="flex items-center justify-between">
            <span class="font-typewriter text-sm tracking-widest uppercase">Event 0{i + 1}</span>
            <span class="h-4 w-4 rounded-full bg-primary ring-1 ring-ink group-hover:bg-on-primary" aria-hidden="true" />
          </span>
          <span
            class="font-display leading-[0.85] uppercase group-hover:!text-on-primary"
            style="font-size: clamp(2.25rem, 3.3vw, 3.5rem); color: var(--c-display-top)"
          >
            {e.data.name}
          </span>
          <span class="font-body">{e.data.tagline}</span>
          <span class="mt-auto border-t border-current pt-3 font-typewriter text-sm">{e.data.dateLabel}</span>
          <span class="font-typewriter text-sm uppercase underline underline-offset-4">Explore {e.data.shortName} →</span>
        </a>
        {i < events.length - 1 && (
          <span
            class="absolute -bottom-5 left-1/2 z-10 -translate-x-1/2 font-typewriter text-2xl md:hidden xl:top-1/2 xl:right-0 xl:bottom-auto xl:left-auto xl:block xl:translate-x-1/2 xl:-translate-y-1/2"
            aria-hidden="true"
          >
            <span class="block rotate-90 xl:rotate-0">→</span>
          </span>
        )}
      </li>
    ))
  }
</ol>
