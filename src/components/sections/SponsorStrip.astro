---
/**
 * Sponsors as wordmarks (or logos once provided).
 *   default  grid
 *   tiered   grouped by tier (sponsors page)
 *   marquee  one infinite row whose speed follows scroll (home); a plain grid
 *            without motion
 */
import type { CollectionEntry } from 'astro:content';
import Media from '../media/Media.astro';
import Kicker from '../typography/Kicker.astro';

type Tier = CollectionEntry<'sponsors'>['data']['tier'];

interface Props {
  sponsors: CollectionEntry<'sponsors'>[];
  variant?: 'grid' | 'tiered' | 'marquee';
  tierLabels?: Record<Tier, string>;
}

const { sponsors, variant = 'grid', tierLabels } = Astro.props;
const tiers: Tier[] = ['major', 'partner', 'community'];
const groups =
  variant === 'tiered'
    ? tiers.map((tier) => ({ tier, items: sponsors.filter((s) => s.data.tier === tier) })).filter((g) => g.items.length)
    : [{ tier: undefined, items: sponsors }];
const cols: Record<Tier, string> = {
  major: 'sm:grid-cols-2',
  partner: 'grid-cols-2 lg:grid-cols-4',
  community: 'grid-cols-2 sm:grid-cols-3 lg:grid-cols-5',
};
---

{
  variant === 'marquee' ? (
    <div class="marquee" data-marquee data-marquee-speed="45">
      <ul class="marquee__track" data-marquee-track>
        {sponsors.map((s) => (
          <li>
            <a href={s.data.url} class="wordmark">
              {s.data.logo ? <Media id={s.data.logo} alt={s.data.name} /> : s.data.name}
            </a>
          </li>
        ))}
        {/* Second copy for a seamless loop; hidden unless the marquee is running. */}
        {sponsors.map((s) => (
          <li class="marquee__dup" aria-hidden="true">
            <a href={s.data.url} class="wordmark" tabindex="-1">
              {s.data.logo ? <Media id={s.data.logo} alt="" /> : s.data.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ) : (
    <div class="flex flex-col gap-12">
      {groups.map((g) => (
        <div>
          {g.tier && tierLabels && <Kicker rule class="mb-5" typewriter>{tierLabels[g.tier]}</Kicker>}
          <ul
            data-reveal="fade-up"
            data-reveal-children
            data-reveal-stagger="0.06"
            class:list={['m-0 grid list-none gap-3 p-0', g.tier ? cols[g.tier] : 'grid-cols-2 sm:grid-cols-3 lg:grid-cols-5']}
          >
            {g.items.map((s) => (
              <li>
                <a href={s.data.url} class:list={['wordmark', variant === 'tiered' && s.data.tier === 'major' && 'wordmark--major']}>
                  {s.data.logo ? <Media id={s.data.logo} alt={s.data.name} /> : s.data.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  )
}
