---
/** Small typewriter label (Special Elite) above titles and sections. */
interface Props {
  tone?: 'ink' | 'accent';
  /** Short horizontal rules either side. */
  rule?: boolean;
  as?: 'p' | 'span' | 'div';
  /** Type the kicker out on scroll. */
  typewriter?: boolean;
  class?: string;
}

const { tone = 'ink', rule = false, as: Tag = 'p', typewriter = false, class: className } = Astro.props;
---

<Tag class:list={['kicker', className]} data-tone={tone} data-rule={String(rule)} data-reveal={typewriter ? 'typewriter' : undefined}>
  <slot />
</Tag>
