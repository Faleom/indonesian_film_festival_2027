---
/** Section title row with a double newspaper rule underneath (an InkRule). */
import Kicker from '../typography/Kicker.astro';
import InkRule from './InkRule.astro';

interface Props {
  title: string;
  kicker?: string;
  id?: string;
  as?: 'h2' | 'h3';
}

const { title, kicker, id, as: Tag = 'h2' } = Astro.props;
---

<div class="section-head">
  <div class="flex flex-col gap-2">
    {kicker && <Kicker tone="accent" typewriter>{kicker}</Kicker>}
    <Tag id={id} class="heading-condensed" data-reveal="fade-up">{title}</Tag>
  </div>
  <slot />
  <InkRule class="section-head__rule" />
</div>
