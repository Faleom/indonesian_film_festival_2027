{
  "$comment": "Font registry. Drop the .woff2 files into /public/fonts with these exact names. Missing files fall back to the stack in src/styles/typography.css. Rushford, Military Script, Etna and Futura need a web licence before launch.",
  "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Jost:wght@400;500;700&family=Oswald:wght@400;600&family=Special+Elite&display=swap",
  "fonts": [
    {
      "family": "Rushford Printed",
      "role": "Display / big titles",
      "cssVar": "--ff-display",
      "fallback": "Bebas Neue, Oswald, sans-serif",
      "files": [{ "file": "RushfordPrinted.woff2", "weight": 400, "style": "normal" }]
    },
    {
      "family": "Military Script",
      "role": "Script accent",
      "cssVar": "--ff-script",
      "fallback": "cursive",
      "files": [{ "file": "MilitaryScript.woff2", "weight": 400, "style": "normal" }]
    },
    {
      "family": "Etna Condensed",
      "role": "Condensed headings",
      "cssVar": "--ff-condensed",
      "fallback": "Oswald, sans-serif",
      "files": [{ "file": "EtnaCondensed.woff2", "weight": 400, "style": "normal" }]
    },
    {
      "family": "Special Elite",
      "role": "Typewriter / kicker / schedule",
      "cssVar": "--ff-typewriter",
      "fallback": "monospace",
      "google": true,
      "files": []
    },
    {
      "family": "Futura",
      "role": "Body",
      "cssVar": "--ff-body",
      "fallback": "Jost, sans-serif",
      "files": [
        { "file": "Futura-Book.woff2", "weight": 400, "style": "normal" },
        { "file": "Futura-Medium.woff2", "weight": 500, "style": "normal" },
        { "file": "Futura-Bold.woff2", "weight": 700, "style": "normal" }
      ]
    }
  ]
}
