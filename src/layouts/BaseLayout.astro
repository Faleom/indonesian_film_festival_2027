---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import MotionHead from '../components/layout/MotionHead.astro';
import Fonts from '../components/layout/Fonts.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import Toast from '../components/layout/Toast.astro';
import fs from 'node:fs';
import path from 'node:path';
import site from '../content/site.json';

export type { Theme } from '../lib/content';
import type { Theme } from '../lib/content';

interface Props {
  title: string;
  description?: string;
  theme?: Theme;
  /** Event pages: the theme colour re-prints over the page on load (motion only). */
  reprint?: boolean;
}

const { title, description = site.description, theme = 'base', reprint = false } = Astro.props;

// Icons generated from src/assets/brand/logo.* by scripts/favicons.mjs.
const pub = (f: string) => fs.existsSync(path.join(process.cwd(), 'public', f));
const icons = { ico: pub('favicon.ico'), svg: pub('icon.svg'), apple: pub('apple-touch-icon.png'), manifest: pub('site.webmanifest') };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {icons.ico && <link rel="icon" href="/favicon.ico" sizes="32x32" />}
    {icons.svg && <link rel="icon" href="/icon.svg" type="image/svg+xml" />}
    {icons.apple && <link rel="apple-touch-icon" href="/apple-touch-icon.png" />}
    {icons.manifest && <link rel="manifest" href="/site.webmanifest" />}
    <MotionHead />
    <Fonts />
    <ClientRouter />
  </head>
  <body class="paper" data-theme={theme} data-reprint={reprint ? '' : undefined}>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="page">
      <Navbar />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
    <Toast />
    <div class="grain" aria-hidden="true"></div>
    <div class="riso-plate" aria-hidden="true"></div>
    <script>
      import '../scripts/motion/index';
    </script>
  </body>
</html>
