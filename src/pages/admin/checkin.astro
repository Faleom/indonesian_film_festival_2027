---
/** Door check-in: scan the QR with the phone camera (where supported) or type the code. */
import AdminLayout from '../../layouts/AdminLayout.astro';
import Off from '../../components/admin/Off.astro';
import { adminState } from '../../server/admin/guard';

export const prerender = false;

const state = adminState(Astro.cookies);
if (state === 'login') return Astro.redirect('/admin/login');
---

<AdminLayout title="Check-in">
  {
    state !== 'ok' ? (
      <Off />
    ) : (
      <Fragment>
        <h1>Door check-in</h1>
        <div class="checkin">
          <div class="checkin__scan">
            <video id="cam" playsinline muted hidden></video>
            <button id="scan" type="button" class="btn btn--primary cursor-pointer">Scan with camera</button>
            <p class="muted" id="scan-note">Uses the phone camera. If it doesn't start, type the code instead.</p>
          </div>
          <form id="manual" class="admin-row">
            <label class="sr-only" for="code">Ticket code</label>
            <input id="code" class="field__input" style="max-width: 16rem; font-family: var(--ff-typewriter); text-transform: uppercase" placeholder="IFF21-XXXX-XXXX" autocomplete="off" autocapitalize="characters" />
            <button class="btn btn--primary cursor-pointer">Check in</button>
          </form>
          <div id="result" class="checkin__result" role="status" aria-live="assertive" hidden></div>
        </div>
      </Fragment>
    )
  }
</AdminLayout>

<style>
  .checkin { display: grid; gap: 1.25rem; max-width: 36rem; }
  .checkin__scan { display: grid; gap: 0.6rem; }
  #cam { width: 100%; max-height: 50vh; border: 2px solid var(--c-black); background: #000; object-fit: cover; }
  .checkin__result { padding: 1.25rem; border: 3px solid; font-size: 1.1rem; }
  .checkin__result strong { display: block; font-family: var(--ff-display); font-size: 2.4rem; font-weight: 400; line-height: 1; margin-bottom: 0.4rem; }
  .checkin__result[data-r='ok'] { border-color: #1b6e3c; background: #d9f0e0; }
  .checkin__result[data-r='already'] { border-color: #8a5a00; background: #fbecc8; }
  .checkin__result[data-r='void'], .checkin__result[data-r='unpaid'], .checkin__result[data-r='unknown'], .checkin__result[data-r='error'] { border-color: #b3261e; background: #f3d6d3; }
</style>

<script>
  const result = document.getElementById('result') as HTMLElement;
  const input = document.getElementById('code') as HTMLInputElement;
  const titles: Record<string, string> = { ok: 'Welcome in', already: 'Already used', void: 'Refunded / void', unpaid: 'Not paid', unknown: 'Unknown code', error: 'Error' };
  let busy = false;
  let lastCode = '';
  let lastAt = 0;

  async function check(code: string) {
    code = code.trim();
    if (!code || busy) return;
    // The camera sees the same QR many times a second: ignore repeats for 4 s.
    if (code === lastCode && Date.now() - lastAt < 4000) return;
    lastCode = code;
    lastAt = Date.now();
    busy = true;
    try {
      const res = await fetch('/api/admin/checkin', { method: 'POST', headers: { 'content-type': 'application/json', accept: 'application/json' }, body: JSON.stringify({ code }) });
      const r = await res.json();
      const kind = r.ok ? r.result : 'error';
      result.dataset.r = kind;
      const when = r.checkedInAt ? new Date(r.checkedInAt).toLocaleTimeString('en-AU', { timeStyle: 'short' }) : '';
      result.innerHTML = '';
      const strong = document.createElement('strong');
      strong.textContent = titles[kind] ?? kind;
      const detail = document.createElement('div');
      detail.textContent = r.ok && r.result !== 'unknown' ? `${r.name} · ${r.label} · ${r.eventName} · ${r.code}${kind === 'already' && when ? ` · first scanned ${when}` : ''}` : r.message ?? r.code ?? '';
      result.append(strong, detail);
      result.hidden = false;
      if ('vibrate' in navigator) navigator.vibrate(kind === 'ok' ? 80 : [60, 60, 60]);
    } catch {
      result.dataset.r = 'error';
      result.textContent = 'No connection. Try again.';
      result.hidden = false;
    } finally {
      busy = false;
    }
  }

  document.getElementById('manual')?.addEventListener('submit', (e) => {
    e.preventDefault();
    lastCode = '';
    check(input.value).then(() => input.select());
  });

  document.getElementById('scan')?.addEventListener('click', async () => {
    const note = document.getElementById('scan-note')!;
    const Detector = (window as unknown as { BarcodeDetector?: new (o: { formats: string[] }) => { detect(v: HTMLVideoElement): Promise<{ rawValue: string }[]> } }).BarcodeDetector;
    if (!Detector) {
      note.textContent = "This browser can't scan QR codes here (try Chrome on Android). Type the code instead.";
      return;
    }
    const video = document.getElementById('cam') as HTMLVideoElement;
    try {
      video.srcObject = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } });
      video.hidden = false;
      await video.play();
      const detector = new Detector({ formats: ['qr_code'] });
      const tick = async () => {
        try {
          const codes = await detector.detect(video);
          if (codes[0]) await check(codes[0].rawValue);
        } catch {}
        requestAnimationFrame(tick);
      };
      tick();
      note.textContent = 'Point the camera at the QR code.';
    } catch {
      note.textContent = 'Camera not available. Type the code instead.';
    }
  });
</script>
