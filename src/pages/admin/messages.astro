---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Off from '../../components/admin/Off.astro';
import DbError from '../../components/admin/DbError.astro';
import { adminLoad } from '../../server/admin/load';
import { adminState } from '../../server/admin/guard';
import { listMessages } from '../../server/admin/queries';

export const prerender = false;

const state = adminState(Astro.cookies);
if (state === 'login') return Astro.redirect('/admin/login');
const loaded = state === 'ok' ? await adminLoad(listMessages) : {};
const list = loaded.data;
const when = (d?: Date | null) => d?.toLocaleString('en-AU', { timeZone: 'Australia/Melbourne', dateStyle: 'medium', timeStyle: 'short' }) ?? '';
---

<AdminLayout title="Messages">
  {
    loaded.error ? <DbError error={loaded.error} /> :
    !list ? (
      <Off />
    ) : (
      <Fragment>
        <h1>Contact messages</h1>
        <p class="admin-row"><a class="btn btn--ghost" href="/api/admin/export/messages.csv">Download CSV</a></p>
        <div class="atable-wrap">
          <table class="atable">
            <thead><tr><th>Received</th><th>From</th><th>Subject</th><th>Message</th><th></th></tr></thead>
            <tbody>
              {list.map((m) => (
                <tr style={m.handled ? 'opacity: 0.55' : undefined}>
                  <td class="muted">{when(m.createdAt)}</td>
                  <td>{m.name}<br /><a href={`mailto:${m.email}?subject=${encodeURIComponent(`Re: ${m.subject}`)}`}>{m.email}</a></td>
                  <td>{m.subject}</td>
                  <td style="max-width: 36rem; white-space: pre-wrap">{m.message}</td>
                  <td>
                    <form method="post" action="/api/admin/action" class="inline">
                      <input type="hidden" name="do" value="message" />
                      <input type="hidden" name="id" value={m.id} />
                      <input type="hidden" name="handled" value={m.handled ? 'false' : 'true'} />
                      <button class="btn btn--ghost cursor-pointer">{m.handled ? 'Reopen' : 'Done'}</button>
                    </form>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Fragment>
    )
  }
</AdminLayout>
