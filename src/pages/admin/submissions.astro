---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Off from '../../components/admin/Off.astro';
import DbError from '../../components/admin/DbError.astro';
import { adminLoad } from '../../server/admin/load';
import { adminState } from '../../server/admin/guard';
import { listSubmissions } from '../../server/admin/queries';

export const prerender = false;

const state = adminState(Astro.cookies);
if (state === 'login') return Astro.redirect('/admin/login');
const loaded = state === 'ok' ? await adminLoad(listSubmissions) : {};
const list = loaded.data;
const when = (d?: Date | null) => d?.toLocaleString('en-AU', { timeZone: 'Australia/Melbourne', dateStyle: 'medium', timeStyle: 'short' }) ?? '';
---

<AdminLayout title="SFC entries">
  {
    loaded.error ? <DbError error={loaded.error} /> :
    !list ? (
      <Off />
    ) : (
      <Fragment>
        <h1>Short Film Competition entries</h1>
        <p class="admin-row"><a class="btn btn--ghost" href="/api/admin/export/submissions.csv">Download CSV</a> <span class="muted">{list.filter((s) => s.status === 'submitted').length} paid · {list.filter((s) => s.status === 'pending_payment').length} started but unpaid</span></p>
        <div class="atable-wrap">
          <table class="atable">
            <thead><tr><th>Status</th><th>Film</th><th>Video</th><th>Filmmaker</th><th>Synopsis / team</th><th>Received</th></tr></thead>
            <tbody>
              {list.map((s) => (
                <tr>
                  <td><span class={`pill pill--${s.status === 'submitted' ? 'ok' : 'warn'}`}>{s.status === 'submitted' ? 'paid' : 'unpaid'}</span></td>
                  <td><strong>{s.filmTitle}</strong><br /><span class="muted">{s.runtimeMinutes} min</span></td>
                  <td><a href={s.videoUrl} target="_blank" rel="noopener noreferrer">{s.videoProvider}</a></td>
                  <td>{s.name}<br /><a href={`mailto:${s.email}`}>{s.email}</a><br /><span class="muted">{s.school} · {s.country}{s.phone ? ` · ${s.phone}` : ''}</span></td>
                  <td style="max-width: 28rem">{s.synopsis}{s.team && <Fragment><br /><span class="muted">Team: {s.team}</span></Fragment>}</td>
                  <td class="muted">{when(s.submittedAt ?? s.createdAt)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Fragment>
    )
  }
</AdminLayout>
