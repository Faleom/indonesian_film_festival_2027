---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import Button from '../components/ui/Button.astro';
import VolunteerForm from '../components/forms/VolunteerForm.astro';
import Kicker from '../components/typography/Kicker.astro';
import pages from '../content/pages.json';

const page = pages.volunteer;
---

<BaseLayout title={page.metaTitle} description={page.metaDescription}>
  <Hero title={page.title} script={page.script} kicker={page.kicker} intro={page.intro} media={page.hero}>
    <Fragment slot="actions">
      <Button href="#register">Register interest</Button>
    </Fragment>
  </Hero>

  <section class="container-page py-8 md:py-12" aria-labelledby="roles">
    <SectionHead title={page.rolesTitle} id="roles" />
    <ol class="m-0 grid list-none gap-6 p-0 sm:grid-cols-2 lg:grid-cols-4">
      {
        page.roles.map((r, i) => (
          <li class="flex flex-col gap-3 border-t-[3px] border-double border-ink pt-4">
            <span class="font-display text-5xl leading-none" style="color: var(--c-display-bottom)">0{i + 1}</span>
            <h3 class="m-0 font-condensed text-2xl leading-tight uppercase">{r.title}</h3>
            <p class="m-0">{r.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container-page grid gap-12 py-16 md:py-24 lg:grid-cols-[1fr_1.6fr] lg:gap-16" aria-labelledby="register-title" id="register">
    <div class="flex flex-col gap-4">
      <Kicker tone="accent">{page.perksTitle}</Kicker>
      <ul class="m-0 flex flex-col gap-3 p-0">
        {page.perks.map((p) => <li class="list-none border-b border-dashed border-ink/50 pb-3 font-condensed text-xl uppercase">✶ {p}</li>)}
      </ul>
    </div>
    <div class="border border-ink p-6 md:p-10">
      <h2 id="register-title" class="heading-condensed mb-6">{page.formTitle}</h2>
      <VolunteerForm />
    </div>
  </section>
</BaseLayout>
